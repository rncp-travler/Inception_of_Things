# -*- mode: ruby -*-
# vi: set ft=ruby :

require "fileutils"
require "securerandom"

# box 출처: Rocky Linux 공식 배포 VirtualBox box (dl.rockylinux.org), p1과 같은 box
# latest 파일명을 쓴다. 이미 받은 box는 이름(BOX)으로 캐시되므로 갱신하려면 vagrant box remove 후 재다운로드
BOX       = "rockylinux-10"
BOX_URL   = "https://dl.rockylinux.org/pub/rocky/10/images/x86_64/Rocky-10-Vagrant-Vbox.latest.x86_64.vagrant.virtualbox.box"
LOGIN     = "taebkim"
SERVER_IP = "192.168.56.110"

# K3s 버전 고정 (평가 날 stable 채널 변경으로 깨지는 것 방지)
K3S_VERSION = "v1.36.5+k3s1"

# confs/ (Deployment, Service, Ingress)를 VM에 올리는 위치. 공유 폴더를 쓰지 않으므로 file provisioner로 복사한다
CONFS_DIR = "/home/vagrant/confs"

# K3s token: 처음 실행 시 랜덤 생성, 이후 같은 값 재사용 (.vagrant/는 git 미추적, 새 clone에서는 새로 생성)
# 클러스터가 살아 있을 때 이 파일만 지우면 server의 기존 token과 달라진다. 지울 때는 vagrant destroy와 함께
TOKEN_FILE = File.join(__dir__, ".vagrant", "k3s-token")
unless File.exist?(TOKEN_FILE)
  FileUtils.mkdir_p(File.dirname(TOKEN_FILE))
  File.write(TOKEN_FILE, SecureRandom.hex(32))
  File.chmod(0600, TOKEN_FILE)
end
K3S_TOKEN = File.read(TOKEN_FILE).strip

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_url = BOX_URL
  config.vm.box_check_update = false

  # 공유 폴더 미사용 (box의 Guest Additions 포함 여부 미확인)
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # ---------- Server (K3s server mode) ----------
  config.vm.define "#{LOGIN}S", primary: true do |server|
    server.vm.hostname = "#{LOGIN}S"
    server.vm.network "private_network", ip: SERVER_IP

    # Traefik + 앱 pod 5개가 올라가므로 p1(1 CPU / 1024MB)보다 크게 잡는다
    server.vm.provider "virtualbox" do |vb|
      vb.name         = "#{LOGIN}S"
      vb.cpus         = 2
      vb.memory       = 2048
      vb.linked_clone = true
      # Rocky box는 IO-APIC가 꺼진 채 배포되어 cpus 2여도 게스트가 CPU 1개로 부팅한다 (dmesg "SMP disabled")
      vb.customize ["modifyvm", :id, "--ioapic", "on"]
    end

    # file provisioner는 대상 디렉터리가 이미 있으면 그 안에 confs/를 하나 더 만들므로 먼저 지운다
    server.vm.provision "shell", inline: "rm -rf #{CONFS_DIR}"
    server.vm.provision "file", source: "confs", destination: CONFS_DIR

    # K3s server 설치 후 CONFS_DIR의 manifests 적용
    server.vm.provision "shell",
      path: "scripts/server.sh",
      env:  { "SERVER_IP" => SERVER_IP, "K3S_TOKEN" => K3S_TOKEN,
              "K3S_VERSION" => K3S_VERSION, "CONFS_DIR" => CONFS_DIR }
  end
end
