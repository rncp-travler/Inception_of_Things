# shellcheck shell=bash disable=SC2034
# p3 고정 버전. install.sh, setup.sh, check.sh가 source해서 쓴다 (버전은 여기에만 둔다)
# 값을 바꾸면 check.sh 기대값도 같이 바뀐다. sha256은 linux/amd64 바이너리 기준 (2026-11-03 조회)
# Docker Engine은 고정하지 않는다: 공식 apt repo 최신을 쓴다 (docker-ce만 고정하면 cli·containerd 의존 버전이 어긋날 수 있음)

# https://github.com/k3d-io/k3d/releases/tag/v5.9.0 (checksums.txt의 _dist/k3d-linux-amd64)
K3D_VERSION="v5.9.0"
K3D_SHA256="06d8f25bc3a971c4eb29e0ff08429b180402db0f4dec838c9eac427e296800a0"

# https://hub.docker.com/r/rancher/k3s/tags (K3s v1.36.5+k3s1, docker 태그는 + 대신 -)
# 비우면 k3d 기본 이미지로 클러스터를 만든다 (setup.sh가 실제 이미지 출력, check.sh는 노드 버전 비교 생략)
K3S_IMAGE="rancher/k3s:v1.36.5-k3s1"

# https://dl.k8s.io/release/v1.36.5/bin/linux/amd64/kubectl.sha256 (서버와 같은 v1.36, version skew ±1 minor 이내)
KUBECTL_VERSION="v1.36.5"
KUBECTL_SHA256="33bc88a24c3b09cf55bfd59e6ca977881b61fc3f25ab65bc80c65b430248648e"

# https://github.com/argoproj/argo-cd/releases/tag/v3.5.7 (3.5는 Kubernetes v1.33~v1.36 지원)
ARGOCD_VERSION="v3.5.7"
ARGOCD_INSTALL_URL="https://raw.githubusercontent.com/argoproj/argo-cd/${ARGOCD_VERSION}/manifests/install.yaml"

# argocd-cm Git polling 주기 (기본 120s + jitter 60s → 최대 3분). 0은 polling을 끄므로 쓰지 않는다
# 변경 후 argocd-repo-server, argocd-application-controller 재시작 필요 (argocd-cm.yaml 문서)
ARGOCD_RECONCILIATION="30s"
ARGOCD_RECONCILIATION_JITTER="0s"
